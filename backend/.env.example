# Local development
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production example
# FRONTEND_URL=https://your-frontend-domain
# BACKEND_BASE_URL=https://your-backend-domain
# CORS_ORIGINS=https://your-frontend-domain

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional when using explicit redirect URI instead of BACKEND_BASE_URL
# GOOGLE_REDIRECT_URI=https://your-backend-domain/auth/callback

# Optional fallback when using a local Google credentials file
# GOOGLE_OAUTH_CREDENTIALS_PATH=credentials.json
